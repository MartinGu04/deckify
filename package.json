{
	"name": "deckify",
	"version": "1.0.0",
	"private": true,
	"description": "A dynamic Spotify control center for Elgato Stream Deck.",
	"author": "MARTIN.G",
	"license": "UNLICENSED",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.marting.deckify\"",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"validate": "streamdeck validate com.marting.deckify.sdPlugin",
		"check": "npm run typecheck && npm run lint && npm run build && npm run smoke && npm test && npm run validate",
		"assets": "node scripts/export-brand-assets.mjs && node scripts/export-key-icons.mjs && node scripts/export-deck-overview.mjs",
		"link": "streamdeck link com.marting.deckify.sdPlugin",
		"restart": "streamdeck restart com.marting.deckify",
		"pack": "node scripts/pack.mjs",
		"profiles:check": "node scripts/profiles.mjs check",
		"profiles:import": "node scripts/profiles.mjs import",
		"profiles:layouts": "node scripts/profiles.mjs layouts",
		"smoke": "node scripts/smoke-test.mjs",
		"test": "vitest run",
		"dev:expire-spotify-token": "node scripts/dev-expire-spotify-token.mjs",
		"native:build": "node scripts/native.mjs build",
		"native:test": "node scripts/native.mjs test"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.1",
		"@eslint/js": "^9.39.0",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/jsdom": "^30.0.0",
		"@types/node": "~24.19.0",
		"eslint": "^9.39.0",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"rollup": "^4.63.6",
		"sharp": "^0.35.5",
		"tslib": "^2.8.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3",
		"ws": "^8.22.0"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.1"
	}
}
