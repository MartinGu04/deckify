{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Deckify",
	"Version": "0.1.0.0",
	"Author": "MARTIN.G",
	"Description": "A dynamic Spotify control center for Elgato Stream Deck.",
	"UUID": "com.marting.deckify",
	"Category": "Deckify",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"Profiles": [
		{
			"Name": "profiles/DECKIFY ⭐ Recommended",
			"DeviceType": 0,
			"Readonly": false,
			"AutoInstall": false,
			"DontAutoSwitchWhenInstalled": false
		},
		{
			"Name": "profiles/SIMPLE",
			"DeviceType": 0,
			"Readonly": false,
			"AutoInstall": false,
			"DontAutoSwitchWhenInstalled": false
		}
	],
	"Actions": [
		{
			"Name": "Deckify Status",
			"UUID": "com.marting.deckify.status",
			"Icon": "imgs/actions/status/icon",
			"Tooltip": "Proof-of-life key: toggles between Deckify and Ready on each press.",
			"VisibleInActionsList": false,
			"Controllers": [
				"Keypad"
			],
			"DisableAutomaticStates": true,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Name": "Deckify",
					"Image": "imgs/actions/status/deckify",
					"Title": "Deckify",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				},
				{
					"Name": "Ready",
					"Image": "imgs/actions/status/ready",
					"Title": "Ready",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Spotify Account",
			"UUID": "com.marting.deckify.spotify.account",
			"Icon": "imgs/actions/spotify-account/icon",
			"Tooltip": "Connect Deckify to your Spotify account and show the connection status.",
			"PropertyInspectorPath": "ui/spotify-account/index.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/spotify-account/disconnected",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Previous Track",
			"UUID": "com.marting.deckify.spotify.previous",
			"Icon": "imgs/actions/playback/previous-icon",
			"Tooltip": "Go back to the previous track on the active Spotify device.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/playback/previous",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Play / Pause",
			"UUID": "com.marting.deckify.spotify.play-pause",
			"Icon": "imgs/actions/playback/play-pause-icon",
			"Tooltip": "Play or pause Spotify on the active device. Shows the current playback state.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/playback/play",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Next Track",
			"UUID": "com.marting.deckify.spotify.next",
			"Icon": "imgs/actions/playback/next-icon",
			"Tooltip": "Skip to the next track on the active Spotify device.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/playback/next",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Now Playing",
			"UUID": "com.marting.deckify.spotify.now-playing",
			"Icon": "imgs/actions/playback/now-playing-icon",
			"Tooltip": "Shows the current Spotify track and artist.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/playback/now-playing",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Volume Down",
			"UUID": "com.marting.deckify.spotify.volume-down",
			"Icon": "imgs/actions/volume/volume-down-icon",
			"Tooltip": "Lower the Spotify volume of the active device (desktop, phone or speaker). Shows the current volume.",
			"PropertyInspectorPath": "ui/volume/index.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/volume/volume-down",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Volume Up",
			"UUID": "com.marting.deckify.spotify.volume-up",
			"Icon": "imgs/actions/volume/volume-up-icon",
			"Tooltip": "Raise the Spotify volume of the active device (desktop, phone or speaker). Shows the current volume.",
			"PropertyInspectorPath": "ui/volume/index.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/volume/volume-up",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Mute / Unmute",
			"UUID": "com.marting.deckify.spotify.mute",
			"Icon": "imgs/actions/volume/mute-icon",
			"Tooltip": "Mute the active Spotify device (volume 0), or restore the previous volume.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/volume/speaker",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Like / Unlike",
			"UUID": "com.marting.deckify.spotify.like",
			"Icon": "imgs/actions/library/like-icon",
			"Tooltip": "Add the current Spotify song to Liked Songs, or remove it. Shows whether it is liked.",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/library/heart-disabled",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Add to Playlist",
			"UUID": "com.marting.deckify.spotify.add-to-playlist",
			"Icon": "imgs/actions/playlist/add-icon",
			"Tooltip": "Add the current Spotify song to a playlist you choose (your own or collaborative). Never adds a song twice.",
			"PropertyInspectorPath": "ui/playlist/index.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/playlist/add-disabled",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		},
		{
			"Name": "Play Playlist",
			"UUID": "com.marting.deckify.spotify.play-playlist",
			"Icon": "imgs/actions/playlist/play-icon",
			"Tooltip": "Start a playlist you choose on the active Spotify device.",
			"PropertyInspectorPath": "ui/playlist/index.html",
			"Controllers": [
				"Keypad"
			],
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/playlist/play-disabled",
					"ShowTitle": true,
					"TitleAlignment": "bottom",
					"TitleColor": "#FFFFFF"
				}
			]
		}
	]
}
